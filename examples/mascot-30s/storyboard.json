     "pose": "point",
     "for": 1.5
    }
   ]
  },
  {
   "id": "s03",
   "type": "statement",
   "say": "So wherever you look, scattered blue light is coming at you from every direction.",
   "text": "Blue light comes from *everywhere*",
   "emphasis": "every direction",
   "mascot": [
    {
     "at": "wherever",
