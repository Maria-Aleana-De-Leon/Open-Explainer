  {
   "id": "s02",
   "type": "bullets",
   "say": "Sunlight looks white, but it is really every colour mixed together. When it hits the air, the tiny gas molecules scatter blue light the most.",
   "heading": "What happens",
   "items": [
    {
     "text": "Sunlight holds every colour",
     "at": "every colour"
    },
    {
     "text": "Air molecules scatter it",
     "at": "scatter"
    },
    {
     "text": "*Blue* scatters the most",
     "at": "blue light"
    }
   ],
   "mascot": [
    {
     "at": "every colour",
     "pose": "present"
    },
    {
